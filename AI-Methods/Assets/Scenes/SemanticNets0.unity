    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: pauseMenu
      value: 
      objectReference: {fileID: 1262979761}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: promptMessage
      value: RS1 fragen
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "Hallo Spieler! In dieser Bibliothek wurde einmal das gesamte Wissen
        der KI gesammelt. Leider sind die Verbindungen verloren gegangen und die
        KI versteht die Zusammenh\xE4nge nicht mehr. Hilf der KI, wieder ein qualitatives
        Wissen herzustellen!\n\nWeiter: 'E'"
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "Wissen kann in der Informatik in sogenannten semantischen Netzen dargestellt
        werden. Knoten repr\xE4sentieren Konzepte, w\xE4hrend Kanten die Beziehungen
        zwischen diesen Konzepten darstellen."
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: 'Das Ergebnis des ersten Levels hat eine Baumstruktur, mit einem ''Wurzel''-Knoten
        und mehreren ''Blatt''-Knoten. Vorsicht: Falsche Verbindungen werden von
        der KI als Fehler gewertet und ziehen Punktabzug nach sich!'
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: 'Denk daran: Je mehr richtige Verbindungen du herstellst, desto besser
        versteht die KI die Welt um sie herum! Nur du kannst sie reparieren.'
      objectReference: {fileID: 0}
    - target: {fileID: 7760609697886708385, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: isInDialogue
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 7760609697886708385, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: promptMessage
      value: 
      objectReference: {fileID: 1538713792}
    - target: {fileID: 7760609697886708385, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: characterAnimator
      value: 
      objectReference: {fileID: 1967293997}
