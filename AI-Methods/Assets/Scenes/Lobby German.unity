    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: pauseMenu
      value: 
      objectReference: {fileID: 3345539542530430290}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: promptMessage
      value: 'Sprechen [E]'
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "Hallo, Spieler. Meine Bezeichnung lautet RS1, und ich werde dir bei
        dieser Mission als dein F\xFChrungsmodul dienen."
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "Oh. Du bist noch nicht \xFCber die Missionsparameter informiert?\nMehrere
        deiner KI-Subsysteme funktionieren derzeit fehlerhaft. Um dieses Problem
        zu beheben, musst du in jeden zugewiesenen Sektor teleportieren und eine
        vollst\xE4ndige Rekalibrierung durchf\xFChren."
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "Die fehlerhaften Methoden lauten wie folgt: Semantische Netze, Suche
        und Entscheidungsb\xE4ume."
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "Gehe durch eine der drei T\xFCren, um die Teleportation zu starten
        und mit der Rekalibrierung zu beginnen. Ich werde mich direkt hinter dir
        halten und dich am Zielort treffen, um weitere Unterst\xFCtzung bereitzustellen."
      objectReference: {fileID: 0}
    - target: {fileID: 7760609697886708385, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: promptMessage
      value: 
      objectReference: {fileID: 1376146501352059861}
    - target: {fileID: 7760609697886708385, guid: bcded6983318aed4994647bf0c941975, type: 3}
