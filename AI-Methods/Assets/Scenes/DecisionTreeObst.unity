--- !u!114 &892591497
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 892591490}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2fb6a7278b66459581beb1ea2c0d5413, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  helpActions:
  - type: 0
    actionName: 
    message: Servus und willkommen auf dem Bauernhof! Der eine oder andere war vielleicht
      schon hier ;)
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: In diesem Minigame baust du einen Entscheidungsbaum.
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: "In diesem Tutorial-Level werde ich dir Schritt-f\xFCr-Schritt zeigen,
      wie das geht :)"
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: Folge mir erstmal zur Maschine!
    targetObject: {fileID: 0}
  - type: 2
    actionName: 
    message: 
    targetObject: {fileID: 1142802290}
  - type: 0
    actionName: 
    message: "Hier wirst du deinen Entscheidungsbaum bauen k\xF6nnen. "
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: "Entscheidungsb\xE4ume entscheiden \xFCber den Wert oder den Wertebereich
      von einer gewissen Eigenschaft."
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: In unserem Fall wollen wir entscheiden, ob ein Essen gut ist oder nicht.
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: 'Dies tun wir hier anhand von zwei Eigenschaften von unserem Essen:
      Obst (Ja/Nein), Rot (Ja/Nein)'
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: "Bevor wir den Baum selbst bauen, sammeln wir ein St\xFCck Essen, was
      wir bewerten wollen. "
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: Wir sammeln die Tomate gemeinsam auf. Folge mir!
    targetObject: {fileID: 0}
  - type: 2
    actionName: 
    message: 
    targetObject: {fileID: 287745965}
  - type: 1
    actionName: tomato_f
    message: "Sammle die Tomate auf, dr\xFCcke dazu [F]"
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: Wir scannen die Tomate nun an der Maschine ein. Folge mir!
    targetObject: {fileID: 0}
  - type: 2
    actionName: 
    message: 
    targetObject: {fileID: 1142802290}
  - type: 1
    actionName: tomato_scan
    message: Bring die Tomate unter das rote Licht, um ihn einzuscannen.
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: Nun siehst du auf dem Bildschirm, ob die Tomate von der Maschine als
      gut erkannt wurde.
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: Wir beginnen jetzt damit, den Entscheidungsbaum zu bauen
    targetObject: {fileID: 0}
  - type: 1
    actionName: rot_card
    message: "\xD6ffne den Editor an der Maschine \xFCber [E] und ziehe die Rot?-Karte
      auf das Fragezeichen ganz links"
    targetObject: {fileID: 0}
  - type: 1
    actionName: first_test
    message: "Dr\xFCcke jetzt [T] um den Testdurchlauf zu starten"
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: "Oh nein, die Maschine ist h\xE4ngen geblieben!"
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: Du siehst an der gelben Warnung, wo sie nicht weiter wusste
    targetObject: {fileID: 0}
  - type: 1
    actionName: obst_card
    message: Ziehe die "Obst?" Karte auf das Fragezeichen unter der Warnung
    targetObject: {fileID: 0}
  - type: 1
    actionName: second_test
    message: Teste jetzt die Maschine erneut!
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: "Super! Nun stimmt aber die Entscheidung von deinem Baum nicht mit der
      Datenbank \xFCberein. "
    targetObject: {fileID: 0}
  - type: 1
    actionName: machine_t_correct
    message: "Klicke auf den Daumen unter der Warnung, um die Entscheidung f\xFCr
      diesen Pfad zu \xE4ndern und teste die Maschine erneut..."
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: "Gut gemacht. Wir sammeln nun das n\xE4chste Essen auf. Folge mir!"
    targetObject: {fileID: 0}
  - type: 2
    actionName: 
    message: 
    targetObject: {fileID: 289877025}
  - type: 1
    actionName: banana_f
    message: "Sammle die Banene auf, dr\xFCcke dazu [F]"
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: Folge mir nun wieder zur Maschine!
    targetObject: {fileID: 0}
  - type: 2
    actionName: 
    message: 
    targetObject: {fileID: 1142802290}
  - type: 1
    actionName: banana_scan
    message: Bring die Banane unter das rote Licht, um ihn einzuscannen.
    targetObject: {fileID: 0}
  - type: 1
    actionName: banana_test
    message: Teste nun die Maschine!
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: "Du siehst, dass die Maschine wieder h\xE4ngen bleibt."
    targetObject: {fileID: 0}
  - type: 1
    actionName: obst_card_2
    message: Ziehe nun die Obst?-Karte auf das Fragezeichen unter der Warnung.
    targetObject: {fileID: 0}
  - type: 1
    actionName: banana_correct
    message: Teste die Maschine jetzt erneut und schaue, dass die Entscheidung von
      deinem Baum der Datenbank entspricht.
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: "Sehr gut! Der Baum ist fast vollst\xE4ndig."
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: "Sammle die \xFCbrigen 2 St\xFCcke Essen hinter dir auf und schaue,
      dass der Baum sie korrekt klassifiziert! "
    targetObject: {fileID: 0}
  - type: 0
    actionName: 
    message: Wenn dein Baum eine falsche Entscheidung trifft, erscheint eine Warnung
      neben dem betroffenen Entscheidungsdaumen.
    targetObject: {fileID: 0}
  - type: 1
    actionName: 
    message: "Erinnerung: Du kannst durch Anklicken des Daumens die Entscheidung
      f\xFCr den jeweiligen Pfad \xE4ndern!"
    targetObject: {fileID: 0}
