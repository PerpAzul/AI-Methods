      value: 
      objectReference: {fileID: 5813618495108259790, guid: 406ab9b921df31e40b4dd86570da21e0, type: 2}
    - target: {fileID: 5573588180988241524, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: m_hasFontAssetChanged
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: arrow
      value: 
      objectReference: {fileID: 1212993716}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: pauseMenu
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: useEvents
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: promptMessage
      value: Rede mit RS1
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "Hier in diesem Schrottplatz musst du lernen, wie man entscheidet, welche
        Gegenst\xE4nde n\xFCtzlich und nicht n\xFCtzlich sind, um die Welt wieder
        aufzubauen!"
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "Daf\xFCr verwenden wir Entscheidungsb\xE4ume. An jedem Knoten wird
        eine Eigenschaft des Gegenstands gepr\xFCft. Wir durchlaufen den Pfad mit
        den geltenden Eigenschaften bis zum Ende, wo dann die Entscheidung, n\xFCtzlich
        oder nicht, getroffen wird."
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "Entscheidungsb\xE4ume sind eine wichtige Methode zur Klassifikation
        im Bereich Machine Learning. Wir benutzen diese Eigenschaftspfade, um einem
        Datenpunkt eine Klasse zuzuordnen. In der Praxis werden Entscheidungsb\xE4ume
        mit Stichproben und Wahrscheinlichkeitsrechnung approximiert."
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "Hier entwirfst du deinen eigenen Entscheidungsbaum, der anhand der
        Eigenschaften eines Gegenstands auswertet, ob dieser n\xFCtzlich ist oder
        nicht. Du kannst du an der Maschine nebenan \"E\" dr\xFCcken, um deinen Baum
        zu bauen!"
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: "Um zu wissen, welche Eigenschaften n\xFCtzlich sind, musst du 3 B\xFCcher
        finden, welche in dem Schrottplatz liegen. Mit der Taste \"E\" kannst du
        diese sammeln. Danach kannst du mit der Taste \"Q\" den Inhalt jederzeit
        aufrufen. Zum Schlie\xDFen der B\xFCcher dr\xFCckst du nochmal \"E\"."
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[5]'
      value: "Damit du deinen Baum testen kannst, musst du 8 Gegenst\xE4nde aufnehmen,
        die im Raum herumliegen. Welche das sind, steht in den B\xFCchern. Das Aufnehmen
        erfolgt mit der Taste \"F\", wenn du dich nah genug am Gegenstand befindest.
        Loslassen kannst du ihn, indem du nochmal \"F\" dr\xFCckst. Aufgenommene
        Gegenst\xE4nde kannst du an der Maschine einscannen (rotes Licht) und angeben,
        ob sie n\xFCtzlich sind oder nicht. "
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[6]'
      value: "Die Gegenst\xE4nde werden dann in die Datenbank aufgenommen. Indem
        du an der Maschine \"T\" dr\xFCckst, testest du die Entscheidungen zu allen
        dort gespeicherten Gegenst\xE4nden f\xFCr deinen Entscheidungsbaum."
      objectReference: {fileID: 0}
    - target: {fileID: 6962799452232891366, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[7]'
      value: "Wenn alle 8 Gegenst\xE4nde richtig klassifiziert werden, hast du einen
        richtigen Baum gefunden und gewonnen! Viel Spa\xDF!"
      objectReference: {fileID: 0}
    - target: {fileID: 7760609697886708385, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: promptMessage
      value: 
      objectReference: {fileID: 288530561}
    - target: {fileID: 7760609697886708385, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: characterAnimator
      value: 
      objectReference: {fileID: 288530562}
    - target: {fileID: 8561251924471793689, guid: bcded6983318aed4994647bf0c941975, type: 3}
      propertyPath: m_IsTrigger
      value: 1
      objectReference: {fileID: 0}
